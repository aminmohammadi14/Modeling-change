+function atomicfile(writefn,path)
+    tmp,io=mktemp(dirname(path))
+    try
+        writefn(io)
+        flush(io)
+        close(io)
+        Base.Filesystem.rename(tmp,path)
+    finally
+        isopen(io) && close(io)
+        isfile(tmp) && rm(tmp)
+    end
+end
