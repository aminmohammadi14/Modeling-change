+function validate_lb(e,u)
+    e["context"] in ("archived_unrestricted","price_unrestricted_physical_cost","inner_physical_cost") ||
+        error("Invalid lower bound source")
+    e["sense"]=="MIN_SENSE" && e["status"] in ("TIME_LIMIT","OPTIMAL") || error("Invalid bound status")
