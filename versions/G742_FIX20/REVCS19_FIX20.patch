+function safe_min(m)
+    st=termination_status(m)
+    st==MOI.INFEASIBLE && return (status=st,lower=Inf,upper=Inf,feasible=false)
+    st in (MOI.OPTIMAL,MOI.TIME_LIMIT) || return (status=st,lower=-Inf,upper=Inf,feasible=false)
+    row = Core20.min_bounds(m)
+    ok,_=feasible_audit(m,1e-5)
+    cost=ok ? objective_value(m) : Inf
+    ok=ok && isfinite(cost) && abs(value(objective_function(m))-cost)<=1e-5
+    lo=isfinite(row.lower) ? row.lower : -Inf
+    ok && lo>cost+1e-7 && error("Invalid minimization interval")
+    return (status=st,lower=lo,upper=ok ? cost : Inf,feasible=ok)
+end
