+function layout(vars)
+    io=IOBuffer()
+    for v in vars
+        println(io,index(v).value,'\t',name(v),'\t',is_binary(v),'\t',is_integer(v),'\t',
+          is_fixed(v) ? repr(fix_value(v)) : "free",'\t',
+          has_lower_bound(v) ? repr(lower_bound(v)) : "-Inf",'\t',
+          has_upper_bound(v) ? repr(upper_bound(v)) : "+Inf")
+    end
+    return bytes2hex(sha256(take!(io)))
+end
