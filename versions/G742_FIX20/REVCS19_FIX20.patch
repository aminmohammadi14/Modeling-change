+function readgeneration(dir,header,ident,vars)
+    id,h=split(strip(read(joinpath(dir,header),String)))
+    string(UUID(id))==id || error("Invalid generation id")
+    path=joinpath(dir,id)
+    digestfile(joinpath(path,"state.toml"))==h || error("Invalid generation checksum")
+    d=TOML.parsefile(joinpath(path,"state.toml"))
+    d["generation"]==id && d["identity"]==ident || error("Checkpoint problem identity differs")
+    d["iteration"] isa Int && d["iteration"]>=0 || error("Invalid iteration")
+    d["phase"] in ("pricing","screen","inner","cost") || error("Invalid checkpoint phase")
+
+    digests=d["columns"]
+    length(digests)>=2 && allunique(digests) && bytes2hex(sha256(join(digests,"\n")))==d["pool_digest"] ||
+        error("Invalid pool digest")
+    if d["phase"]=="cost" || d["upper"]!="+Inf"
+        proof=d["phase"]=="cost" ? d["coverage"] : d["upper_proof"]["coverage_evidence"]
+        proof["kind"] in ("root_rational","leaf_rational") && proof["upper"]=="0" &&
+          !isempty(proof["active"]) && issubset(proof["active"],digests) || error("Missing coverage evidence")
+    end
+    if d["upper"]!="+Inf"
+        proof=d["upper_proof"]
+        proof["snapshot_hash"]==digestfile(joinpath(path,"upper_witness.tsv")) &&
+            udigest(witness20(joinpath(path,"upper_witness.tsv")))==proof["scenario"] || error("Cost witness mismatch")
+        isfinite(d["upper"]) && proof["bound"]==d["upper"] && proof["sense"]=="MAX_SENSE" &&
+            proof["status"] in ("OPTIMAL","TIME_LIMIT") && proof["coverage"]=="rational_cover" &&
+            proof["covered_pool"]==proof["pool"] && issubset(proof["pool"],digests) &&
+            !isempty(proof["pool"]) && proof["incumbent"]<=proof["bound"] &&
+            0<=proof["residual"]<=proof["tolerance"] && d["lb"]["bound"]<=proof["bound"] ||
+            error("Invalid retained cost proof")
+    end
+    cols=map(enumerate(digests)) do (i,h)
+        file=joinpath(path,"column_$i.tsv")
+        digestfile(file)==h || error("Damaged resume column")
+        read_pattern20(file,vars)
+    end
+    function loadscenario(file,h)
+        p=joinpath(path,file)
+        digestfile(p)==h || error("Scenario snapshot corrupted")
+        witness20(p)
+    end
+    u=loadscenario("witness.tsv",d["witness_file"])
+    candidate=isempty(d["candidate_file"]) ? nothing : loadscenario("candidate.tsv",d["candidate_file"])
+    (d["phase"]=="inner")==(!isnothing(candidate)) || error("Candidate phase mismatch")
+    tr=d["trace_digest"]
+    isempty(tr) || digestfile(joinpath(path,"trace.csv"))==tr || error("Trace checksum mismatch")
+    e=d["lb"]
+    validate_lb(e,u)
+    if haskey(e,"solver_record")
+        t=e["solver_record"]
+        all(k->t[k]==e[k],("context","sense","status","bound","incumbent")) || error("Bound evidence mismatch")
+    elseif e["context"]=="archived_unrestricted"
+        info=g742_csvone(joinpath(G742_ROOT,"checkpoint","FIX17_NATIVE_PRODUCTION.csv"))
+        e["bound"]==parse(Float64,info["next_inner_lower_bound"]) && e["scenario"]==info["extracted_scenario_sha256"] ||
+            error("Archived seed proof mismatch")
+    else
+        t=g742_csv_records(read(joinpath(G742_ROOT,"checkpoint","legacy_pricing_trace.csv")))
+        r=only(Dict(zip(first(t),x)) for x in t[2:end] if first(x)=="price_unrestricted_physical_cost")
+        e["bound"]==parse(Float64,r["bound"]) && udigest(u)==udigest(first(candidates20())) ||
+            error("Pricing proof missing")
+    end
+    for (key,r) in d["cache"]
+        occursin(r"^[a-f0-9]{64}:[a-f0-9]{64}$",key) && last(split(key,':')) in digests || error("Invalid cached scope")
+        r["status"] in ("unknown","feasible","excluded") || error("Invalid certificate kind")
+    end
+    return d,cols,u,candidate
+end
